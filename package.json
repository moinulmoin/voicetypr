{
  "name": "voicetypr",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ci:mac": "bash ./scripts/ci-local-macos.sh",
    "ci:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\ci-local-windows.ps1",
    "ci:win:full": "powershell -ExecutionPolicy Bypass -File .\\scripts\\ci-local-windows.ps1 -Full",
    "sidecar:ensure-ffmpeg": "node scripts/ensure-ffmpeg-sidecar.cjs",
    "sidecar:build": "bash ./scripts/build-parakeet-sidecar.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev-tauri.cjs",
    "windows:store:msix": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-msix-store.ps1",
    "windows:store:stage": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-msix-store.ps1 -NoPack",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "lint": "oxlint src --deny-warnings",
    "check": "./scripts/check.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:backend": "cd src-tauri && cargo test",
    "test:frontend": "vitest run",
    "test:all": "pnpm test:backend && pnpm test:frontend",
    "benchmark": "node scripts/benchmark-runner.js",
    "macos:sign": "./scripts/macos-sign-app.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.1.0",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "shadcn": "^4.18.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
